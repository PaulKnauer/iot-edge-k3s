# Local secrets for `make apply-*` — GIT-IGNORED, never commit.
#
# Usage:
#   source infra/.secrets.env && make apply-mqtt-mcp
#
# Each value maps to a get_env(...) lookup in a live terragrunt.hcl.

# ── clock-server API auth ──────────────────────────────────────────────────
# The credential clock-server validates (format: id|token|scopes).
export CLOCK_SERVER_API_AUTH_CREDENTIALS="ops|25e94e97a663699c38cc8a4ed980f9c29d755bdc3dfe3503|*"

# ── mqtt-mcp -> clock-server write path ────────────────────────────────────
# Bare bearer token; MUST equal the token field above so the write path passes
# clock-server's /ready preflight.
export MQTT_MCP_REST_AUTH_TOKEN="25e94e97a663699c38cc8a4ed980f9c29d755bdc3dfe3503"

# ── Hindsight DeepSeek LLM API key ─────────────────────────────────────────
# Used by infra/live/home/hindsight/terragrunt.hcl -> HINDSIGHT_LLM_API_KEY.
export HINDSIGHT_LLM_API_KEY="sk-b53c3bf04f8a4fc08d9c12943ed73d36"

# ── registry pull credentials (fill in if/when the registry requires auth) ──
# export REGISTRY_USERNAME=""
# export REGISTRY_PASSWORD=""
